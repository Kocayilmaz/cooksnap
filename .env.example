# AI providers (free mode) — recipe generation is unavailable without these.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: model overrides used when a user supplies their own premium key
# (see lib/ai/claudeProvider.ts, lib/ai/openaiProvider.ts). No API key here —
# premium keys are entered by the user in the browser and sent per-request,
# never stored on the server.
# CLAUDE_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o-mini

# Optional: best-effort recipe video lookup (lib/ai/youtube.ts). Recipes work
# fine without it, the video section is just skipped.
YOUTUBE_API_KEY=

# NavBar arama kutusunu besleyen tarif veritabani (lib/mealdb/client.ts).
# TheMealDB'nin herkese acik test key'i "1" - gelistirme icin yeterli, gercek
# trafikte themealdb.com/api.php uzerinden supporter key alinmasi onerilir.
MEALDB_API_KEY=1

# Anasayfadaki "Keşfet" bölümü için ikinci tarif kaynağı (lib/spoonacular/client.ts).
# Ücretsiz key: https://spoonacular.com/food-api — anahtar yoksa bölüm sessizce gizlenir.
SPOONACULAR_API_KEY=

# Optional: best-effort Firestore sync for favorites (lib/firebase/config.ts).
# Falls back to localStorage-only when unset.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
