rules_version = '2';

// CookSnap Firestore guvenlik kurallari.
// favorites/{uid}: sadece o uid'ye sahip, giris yapmis kullanici kendi
// dokumanini okuyup yazabilir (bkz. lib/firebase/favoritesSync.ts —
// dokuman id'si her zaman Firebase Auth'un kendi uid'si).
service cloud.firestore {
  match /databases/{database}/documents {
    match /favorites/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // recipes/{id}: CookSnap'in kendi cok dilli tarif veritabani (bkz.
    // lib/firebase/recipesClient.ts). Herkese acik okuma; yazma sadece
    // scripts/seedRecipes.ts'in kullandigi firebase-admin servis hesabi
    // uzerinden yapilir, uygulama client'indan asla.
    match /recipes/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
